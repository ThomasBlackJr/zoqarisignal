# SQLite default; run backend commands from this directory.
DATABASE_URL=sqlite:///./data/drive.db
# Production: set a managed PostgreSQL DATABASE_URL through the deployment secret store.
# postgres:// and postgresql:// are normalized to the installed psycopg driver.
# See SIGNAL-HANDOFF.md for migrations, TLS, audio storage and hosting blockers.
UPLOAD_DIR=./data/audio
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=12
MAX_UPLOAD_MB=24
# demo uses a fixed synthetic transcript; openai processes actual recordings.
TRANSCRIPTION_PROVIDER=demo
QA_PROVIDER=demo
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
QA_MODEL=gpt-4o-mini
WORKER_ENABLED=true
# Local development only. Existing .env files are never overwritten by setup.
ENVIRONMENT=development
MAIL_DELIVERY=local
MAIL_OUTBOX_DIR=./data/mail-outbox
DEV_ENTITLEMENTS_ENABLED=true
# Production requires HTTPS, COOKIE_SECURE=true, MAIL_DELIVERY=smtp and both
# development features disabled, plus a persistent PostgreSQL DATABASE_URL.
# This local-disk/worker backend cannot currently run safely on Vercel Functions.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
