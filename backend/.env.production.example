# TEMPLATE ONLY. Inject real values through protected server configuration.
# Never commit a populated .env. No environment flag grants pilot access.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST/signal?sslmode=verify-full
FRONTEND_ORIGIN=https://signal.zoqari.com
COOKIE_SECURE=true
SESSION_HOURS=12
MAX_UPLOAD_MB=24
MAIL_DELIVERY=resend
RESEND_API_KEY=
RESEND_FROM=AccountManagement@zoqari.com
TRANSCRIPTION_PROVIDER=openai
QA_PROVIDER=openai
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
QA_MODEL=gpt-4o-mini
UPLOAD_DIR=/var/lib/zoqari-signal/audio
WORKER_ENABLED=true
DEV_ENTITLEMENTS_ENABLED=false
# Keep VERCEL/DRIVE_E2E absent. Leave Stripe unconfigured for the free pilot.
